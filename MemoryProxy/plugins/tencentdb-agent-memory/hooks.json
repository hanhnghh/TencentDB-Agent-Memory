{
  "description": "TencentDB Agent Memory lifecycle context",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/memory-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Restoring Agent Memory context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/memory-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking prompt-relevant memory",
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
